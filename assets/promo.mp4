lc(var(--ucoub-float) / 2) ease-in-out var(--ucoub-delay) infinite alternate}@keyframes ucoub-float{0%{transform:translateY(0)}to{transform:translateY(-5px)}}.ucoub-zone{--ucoub-grid:color-mix(in srgb, var(--ucoub-border) 28%, transparent);background-image:linear-gradient(var(--ucoub-grid) 1px, transparent 1px), linear-gradient(90deg, var(--ucoub-grid) 1px, transparent 1px);background-position:top;background-size:28px 28px;transition:border-color .2s,box-shadow .2s,background-color .2s}.ucoub-zone[data-dragging]{--ucoub-grid:color-mix(in srgb, var(--ucoub-border) 55%, transparent);border-color:var(--ucoub-accent);box-shadow:0 0 0 4px color-mix(in srgb, var(--ucoub-accent) 18%, transparent), 0 12px 40px -12px color-mix(in srgb, var(--ucoub-accent) 45%, transparent)}.ucoub-ring{opacity:0;box-shadow:inset 0 0 0 2px var(--ucoub-accent), inset 0 0 36px 0 color-mix(in srgb, var(--ucoub-accent) 24%, transparent);transition:opacity .2s}.ucoub-zone[data-dragging] .ucoub-ring{opacity:1}.ucoub-vignette{background:radial-gradient(70% 60% at 50% 35%, transparent 40%, var(--ucoub-surface) 100%)}.ucoub-caret{background-color:var(--ucoub-accent)}.ucoub-fade{animation:.35s ease-out both ucoub-fade}@keyframes ucoub-fade{0%{opacity:0}to{opacity:1}}.ucoub-wash{background-image:radial-gradient(120% 80% at 50% 110%, color-mix(in srgb, var(--ucoub-accent) 22%, transparent), transparent 70%)}.ucoub-bar{background-color:var(--ucoub-accent);box-shadow:0 0 12px var(--ucoub-accent);transition:width .25s linear}@media (prefers-reduced-motion:reduce){.ucoub-enter,.ucoub-rise,.ucoub-float,.ucoub-fade{animation:none}.ucoub-arc,.ucoub-bar{transition:none}}</style></head><body class="bg-surface-1 text-primary font-sans min-h-screen chat-ui-core"><script type="application/json" id="static-composer-translations">{"de-DE":{"greeting":"Du bist da!","placeholder":"Wie kann ich dir heute helfen?","aria-label":"Schreibe deinen Prompt an Claude"},"fr-FR":{"greeting":"Vous voilà !","placeholder":"Comment puis-je vous aider aujourd'hui ?","aria-label":"Écrivez votre invite à Claude."},"ko-KR":{"greeting":"안녕하세요!","placeholder":"오늘 어떤 도움을 드릴까요?","aria-label":"Claude에게 프롬프트를 입력하세요."},"ja-JP":{"greeting":"ようこそ！","placeholder":"今日はどのようなご用件でしょうか？","aria-label":"Claudeへのプロンプトを入力してください"},"es-419":{"greeting":"¡Aquí estás!","placeholder":"¿Cómo puedo ayudarte hoy?","aria-label":"Escribe tu mensaje para Claude"},"es-ES":{"greeting":"¡Ya estás aquí!","placeholder":"¿En qué puedo ayudarte hoy?","aria-label":"Escriba su consulta para Claude"},"it-IT":{"greeting":"Eccoti!","placeholder":"Come posso aiutarti oggi?","aria-label":"Scrivi il tuo prompt per Claude"},"hi-IN":{"greeting":"नमस्ते!","placeholder":"आज मैं आपकी कैसे मदद कर सकता/सकती हूं?","aria-label":"Claude को अपना प्रॉम्प्ट लिखें"},"pt-BR":{"greeting":"Que bom ter você aqui!","placeholder":"Como posso ajudar você hoje?","aria-label":"Escreva as instruções para o Claude"},"id-ID":{"greeting":"Halo, kamu!","placeholder":"Ada yang bisa saya bantu hari ini?","aria-label":"Tulis prompt Anda ke Claude"},"am":{"greeting":"እንኳን ደህና መጡ!","placeholder":"ዛሬ እንዴት ልረዳዎት እችላለሁ?","aria-label":"ለClaude የሚልኩትን ጥያቄ ይጻፉ"},"bho":{"greeting":"रउआ आ गइनी!","placeholder":"आज हम राउर का मदद कर सकीले?","aria-label":"Claude खातिर आपन प्रॉम्प्ट लिखीं"},"bn":{"greeting":"এসে গেছেন!","placeholder":"আজ আমি আপনাকে কীভাবে সাহায্য করতে পারি?","aria-label":"Claude-কে আপনার প্রম্পট লিখুন"},"da":{"greeting":"Dejligt at se dig!","placeholder":"Hvad kan jeg hjælpe dig med i dag?","aria-label":"Skriv din prompt til Claude"},"fi":{"greeting":"Kiva nähdä!","placeholder":"Miten voin auttaa sinua tänään?","aria-label":"Kirjoita kehotteesi Claudelle"},"fil":{"greeting":"Nandito ka na!","placeholder":"Paano kita matutulungan ngayon?","aria-label":"Isulat ang iyong prompt kay Claude"},"gu":{"greeting":"તમે આવી ગયા!","placeholder":"આજે હું તમને કેવી રીતે મદદ કરી શકું?","aria-label":"Claude ને તમારો પ્રોમ્પ્ટ લખો"},"ha":{"greeting":"Barka da zuwa!","placeholder":"Ta yaya zan iya taimaka maka a yau?","aria-label":"Rubuta saƙonka zuwa ga Claude"},"ig":{"greeting":"Nnọọ!","placeholder":"Kedu ka m ga-esi nyere gị aka taa?","aria-label":"Dee ozi gị nye Claude"},"kn":{"greeting":"ನೀವು ಬಂದಿರಿ!","placeholder":"ಇಂದು ನಿಮಗೆ ಹೇಗೆ ಸಹಾಯ ಮಾಡಲಿ?","aria-label":"Claude ಗೆ ನಿಮ್ಮ ಪ್ರಾಂಪ್ಟ್ ಬರೆಯಿರಿ"},"ml":{"greeting":"നിങ്ങൾ എത്തിയല്ലോ!","placeholder":"ഇന്ന് നിങ്ങളെ എങ്ങനെ സഹായിക്കാം?","aria-label":"Claude-ന് നിങ്ങളുടെ പ്രോംപ്റ്റ് എഴുതുക"},"mr":{"greeting":"तुम्ही आलात!","placeholder":"आज मी तुम्हाला कशी मदत करू शकतो?","aria-label":"Claude ला तुमचा प्रॉम्प्ट लिहा"},"nb":{"greeting":"Der er du!","placeholder":"Hva kan jeg hjelpe deg med i dag?","aria-label":"Skriv ledeteksten din til Claude"},"nl":{"greeting":"Fijn dat je er bent!","placeholder":"Waarmee kan ik je vandaag helpen?","aria-label":"Schrijf je prompt aan Claude"},"ny":{"greeting":"Mwafika!","placeholder":"Ndingakuthandizeni bwanji lero?","aria-label":"Lembani uthenga wanu kwa Claude"},"om":{"greeting":"Baga nagaan dhufte!","placeholder":"Har'a maal si gargaaruu danda'a?","aria-label":"Ergaa kee Claude-f barreessi"},"rn":{"greeting":"Kaze!","placeholder":"Nokugira iki uyu musi?","aria-label":"Andika ubutumwa bwawe ushaka kurungikira Claude"},"ru":{"greeting":"Рады вас видеть!","placeholder":"Чем я могу вам помочь?","aria-label":"Напишите запрос Claude"},"rw":{"greeting":"Uraho!","placeholder":"Nagufasha iki uyu munsi?","aria-label":"Andika ubutumwa bwawe kuri Claude"},"so":{"greeting":"Waad timid!","placeholder":"Sidee kuu caawin karaa maanta?","aria-label":"Qor farriintaada aad u dirayso Claude"},"sv":{"greeting":"Vad kul att du är här!","placeholder":"Hur kan jag hjälpa dig idag?","aria-label":"Skriv din prompt till Claude"},"sw":{"greeting":"Umefika!","placeholder":"Nikusaidie nini leo?","aria-label":"Andika ombi lako kwa Claude"},"ta":{"greeting":"வாருங்கள்!","placeholder":"இன்று நான் உங்களுக்கு எப்படி உதவலாம்?","aria-label":"Claude-க்கு உங்கள் ப்ராம்ப்டை எழுதவும்"},"te":{"greeting":"మీరు వచ్చారు!","placeholder":"ఈ రోజు నేను మీకు ఎలా సహాయపడగలను?","aria-label":"Claudeకు మీ ప్రాంప్ట్‌ను రాయండి"},"th":{"greeting":"ยินดีที่ได้เจอกัน","placeholder":"วันนี้ให้ฉันช่วยอะไรดี","aria-label":"เขียนพรอมต์ของคุณถึง Claude"},"tr":{"greeting":"Hoş geldiniz!","placeholder":"Bugün size nasıl yardımcı olabilirim?","aria-label":"Claude'a göndereceğiniz istemi yazın"},"uk":{"greeting":"Раді вас бачити!","placeholder":"Чим можу допомогти вам сьогодні?","aria-label":"Напишіть свій промпт для Claude"},"vi":{"greeting":"Bạn đã đến rồi!","placeholder":"Hôm nay tôi có thể giúp gì cho bạn?","aria-label":"Viết câu lệnh gửi Claude"},"wo":{"greeting":"Dalal ak jàmm!","placeholder":"Naka laa la mën a dimbali tey?","aria-label":"Bindal sa bataaxal ngir Claude"},"yo":{"greeting":"Kú àbọ̀!","placeholder":"Báwo ni mo ṣe lè ràn ọ́ lọ́wọ́ lónìí?","aria-label":"Kọ ìbéèrè rẹ sí Claude"},"zh-Hans":{"greeting":"您来啦！","placeholder":"今天我能为您做些什么？","aria-label":"输入您发送给 Claude 的提示词"},"zh-Hant":{"greeting":"您來啦！","placeholder":"今天我能為您做些什麼？","aria-label":"撰寫您要傳送給 Claude 的提示"}}</script><div id="open-incognito-widget" role="button" tabindex="0" aria-label="현재 탭을 시크릿 모드에서 열기"><template shadowrootmode="open"><style>
